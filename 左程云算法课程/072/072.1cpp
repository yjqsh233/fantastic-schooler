//https://leetcode.cn/problems/longest-increasing-subsequence/
class Solution {
public:
    int dp[2505]; // dp[i]表示以nums[i]结尾的最长严格递增子序列
    int lengthOfLIS(vector<int>& nums) {
        dp[0] = 1;
        int ans = dp[0];
        int n = nums.size();
        if (n == 1) {
            return dp[0];
        }
        if (nums[1] > nums[0]) {
            dp[1] = 2;
        } else {
            dp[1] = 1;
        }
        if (n == 2) {
            return dp[1];
        }
        ans = max(ans, dp[1]);
        for (int i = 2; i < n; i++) {
            dp[i] = 1;
            for (int j = 0; j < i; j++) {
                dp[i] = max(dp[i], nums[i] > nums[j] ? dp[j] + 1 : 1);
            }
            ans = max(ans, dp[i]);
        }
        return ans;
    }
};
// O(n^2)的算法是容易的，但最优解是O(nlogn)
// 性能：79ms/13.7MB
// 在学习O(nlogn)解法前可以复习一下二分搜索的两种实现
class Solution {
public:
    int dp[2501]; // 目前为止，长度为i严格递增子序列的最小结尾
    int lengthOfLIS(vector<int>& nums) {
        int n = nums.size();
        int ans = 1;
        dp[1] = nums[0];
        for (int i = 1; i < n; i++) {
            if (nums[i] > dp[ans]) {
                ans++;
                dp[ans] = nums[i];
            } else {
                int l = 0;
                int r = ans;
                while (l + 1 != r) {
                    int m = l + (r - l) / 2;
                    if (dp[m] >= nums[i]) {
                        r = m;
                    } else {
                        l = m;
                    }
                }
                dp[r] = nums[i];
            }
        }
        return ans;
    }
};
// 性能：3ms/13.70MB
// 这里采用二分搜索的红蓝边界模型+新的dp定义，关键在于怎么从第一种解法
// 过渡到第二种解法
class Solution {
public:
    int dp[2501]; // 目前为止，长度为i非严格递增子序列的最小结尾
    int lengthOfLIS(vector<int>& nums) {
        int n = nums.size();
        int ans = 1;
        dp[1] = nums[0];
        for (int i = 1; i < n; i++) {
            if (nums[i] >= dp[ans]) {
                ans++;
                dp[ans] = nums[i];
            } else {
                int l = 0;
                int r = ans;
                while (l + 1 != r) {
                    int m = l + (r - l) / 2;
                    if (dp[m] > nums[i]) {
                        r = m;
                    } else {
                        l = m;
                    }
                }
                dp[r] = nums[i];
            }
        }
        return ans;
    }
};
// 最长不下降子序列问题
